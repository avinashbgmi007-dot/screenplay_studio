      "elements": [
        {
          "type": "scene_heading",
          "text": "EXT. CITY ROAD - NIGHT",
          "character": null,
          "line_start": 18
        },
        {
          "type": "action",
          "text": "RAVI walks with MEERA along an empty road. She carries a folder she never",
          "character": null,
          "line_start": 20
        },
        {
          "type": "action",
          "text": "opens.",
          "character": null,
          "line_start": 21
        },
        {
          "type": "character",
          "text": "MEERA",
          "character": "MEERA",
          "line_start": 23
        },
        {
          "type": "dialogue",
          "text": "You keep rewriting the same scene. That's not revision, that's hiding.",
          "character": "MEERA",
          "line_start": 24
        },
        {
          "type": "character",
          "text": "RAVI",
          "character": "RAVI",
          "line_start": 26
        },
        {
          "type": "dialogue",
          "text": "Then tell me what's wrong with it.",
          "character": "RAVI",
          "line_start": 27
        },
        {
          "type": "character",
          "text": "MEERA",
          "character": "MEERA",
          "line_start": 29
        },
        {
          "type": "dialogue",
          "text": "Nothing's wrong with the words. You're scared the story is really about you.",
          "character": "MEERA",
          "line_start": 30
        },
        {
          "type": "action",
          "text": "RAVI stops walking.",
          "character": null,
          "line_start": 32
        },
        {
          "type": "character",
          "text": "RAVI",
          "character": "RAVI",
          "line_start": 34
        },
        {
          "type": "dialogue",
          "text": "It is. That's the part I can't fix on paper.",
          "character": "RAVI",
          "line_start": 35
        },
        {
          "type": "transition",
          "text": "CUT TO:",
          "character": null,
          "line_start": 37
        }
      ]
    },
    {
