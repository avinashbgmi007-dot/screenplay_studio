          "text": "INT. WRITER'S ROOM - NIGHT",
          "character": null,
          "line_start": 3
        },
        {
          "type": "action",
          "text": "RAVI sits at a small desk under a single lamp. A stack of blank pages in",
          "character": null,
          "line_start": 5
        },
        {
          "type": "action",
          "text": "front of him, a clock showing 2:14 AM. He writes a line, crosses it out,",
          "character": null,
          "line_start": 6
        },
        {
          "type": "action",
          "text": "writes again.",
          "character": null,
          "line_start": 7
        },
        {
          "type": "character",
          "text": "RAVI",
          "character": "RAVI",
          "line_start": 9
        },
        {
          "type": "parenthetical",
          "text": "(under his breath)",
          "character": "RAVI",
          "line_start": 10
        },
        {
          "type": "dialogue",
          "text": "Fifty pages and the second act still won't stand up.",
          "character": "RAVI",
          "line_start": 11
        },
        {
          "type": "action",
          "text": "His phone buzzes. He ignores it, reaches for a cold cup of tea.",
          "character": null,
          "line_start": 13
        },
        {
          "type": "character",
          "text": "RAVI",
          "character": "RAVI",
          "line_start": 15
        },
        {
          "type": "dialogue",
          "text": "Okay. What does the character actually want? Not what I want her to want.",
          "character": "RAVI",
          "line_start": 16
        }
      ]
    },
    {
      "scene_number": 2,
      "heading_raw": "EXT. CITY ROAD - NIGHT",
      "int_ext": "EXT",
      "location": "CITY ROAD",
      "time_of_day": "NIGHT",
      "page_start": null,
      "page_end": null,
      "characters_present": [
