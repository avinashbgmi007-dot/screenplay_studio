# Script Doctor Studio — example local environment.
# Copy to .env.local (gitignored, stays on your machine) and adjust.
# Values here are placeholders only — nothing sensitive belongs in git.

# Run with the built-in demo craft model instead of a llama-server.
# The UI shows an amber "demo" connection status while this is active.
SCREENPLAY_STUDIO_DEMO_MODEL=1

# --- Dictation (speech-to-text) ---------------------------------------------
# Leave these unset to use the built-in local model (faster-whisper), which
# downloads once and then works offline forever.
# If you already run a whisper.cpp server, it MUST be loopback:
# localhost / 127.0.0.1 / ::1. Anything else is refused — this desk never sends
# audio off the machine. (A prefix-matching guard used to accept
# "http://127.0.0.1@evil.com" and "http://localhost.evil.com"; it is now parsed
# and the hostname compared exactly.)
# SCREENPLAY_STUDIO_WHISPER_URL=http://localhost:8081
# SCREENPLAY_STUDIO_STT_MODEL=tiny

# --- Prompt budgets (quality knobs; each has a working default) -------------
# The analyzer injects craft rules into its prompts. The 'character' fragment
# alone runs ~65k chars against a 40k soft ceiling, so the pipeline emits a
# RuntimeWarning on every run. Raising this spends context window; lowering it
# drops rules. Set it to silence the warning only if you have decided the trade.
# SCREENPLAY_KB_BUDGET=40000

# The co-writer's irreducible context (persona + guards + examples + findings)
# currently runs ~8.5k chars. A budget below that cannot be honoured, and the
# model truncates SILENTLY — nothing in the UI can tell you it happened. Raise
# it to whatever your model's real window allows.
# SCREENPLAY_PROMPT_BUDGET=12000
