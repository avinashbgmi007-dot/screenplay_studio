      "elements": [
        {
          "type": "scene_heading",
          "text": "INT. WRITER'S ROOM - DAWN",
          "character": null,
          "line_start": 39
        },
        {
          "type": "action",
          "text": "Grey light through the window. The desk is covered in crossed-out pages,",
          "character": null,
          "line_start": 41
        },
        {
          "type": "action",
          "text": "but one page lies clean at the center. Ravi reads it aloud.",
          "character": null,
          "line_start": 42
        },
        {
          "type": "character",
          "text": "RAVI",
          "character": "RAVI",
          "line_start": 44
        },
        {
          "type": "dialogue",
          "text": "She doesn't forgive him. She just stops carrying it.",
          "character": "RAVI",
          "line_start": 45
        },
        {
          "type": "action",
          "text": "He nods once, sets the page down gently, and picks up a fresh sheet.",
          "character": null,
          "line_start": 47
        }
      ]
    }
